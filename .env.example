# Server-only. Set in the runtime environment; never use NEXT_PUBLIC_ for secrets.
# Brevo HTTP API (works on Cloudflare Workers). Create an API key in Brevo → SMTP & API → API keys.
# Do not use an SMTP key (xsmtpsib-…); use an API key (xkeysib-…).
ENQUIRY_PROVIDER=brevo
BREVO_API_KEY=
ENQUIRY_FROM=info@shiningvacationhomes.com
ENQUIRY_TO=info@shiningvacationhomes.com
ENQUIRY_BCC=
# Exact public HTTPS origin is recommended behind a proxy; no trailing slash.
ENQUIRY_ORIGIN=
# Canonical site URL, not a secret. Set to the final approved public domain.
NEXT_PUBLIC_SITE_URL=https://shiningvacationhomes.com

# Cloudflare Turnstile (bot protection on the enquiry form). Create a widget in the Cloudflare dashboard.
# Site key is public; secret key stays server-only. Local without these skips the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public hosting: managed PostgreSQL (required on Vercel), or persistent disk on a Node server.
ENQUIRY_DATABASE_URL=
# Stable private key: 32 random bytes encoded as 64 hex characters. Back it up securely.
ENQUIRY_DATA_KEY=
# Optional Node server path; do not use an ephemeral directory on public hosting.
ENQUIRY_STORAGE_DIR=

# Optional alternatives:
# ENQUIRY_PROVIDER=gmail with SMTP_USER + SMTP_APP_PASSWORD
# ENQUIRY_PROVIDER=resend with RESEND_API_KEY + ENQUIRY_FROM + ENQUIRY_TO

{
  "name": "shining-vacation-homes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "opennextjs-cloudflare build",
    "build:next": "node scripts/build.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4173",
    "start": "next start",
    "preview": "next start --hostname 127.0.0.1 --port 4173",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:release": "node scripts/check-release.mjs",
    "check:email": "node scripts/check-email.mjs",
    "enquiries": "node scripts/enquiries.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
